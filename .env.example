# 本地运行使用此地址；账号、密码填写实际已有数据库的信息。
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=hscode
PGUSER=hscode
PGPASSWORD=replace-with-your-database-password

# Docker 应用连接已有数据库的地址与网络，按服务器实际配置修改。
HSCODE_DOCKER_DB_HOST=shared-postgres
HSCODE_DOCKER_NETWORK=shared-infra

HSCODE_PORT=8765
# 同机反向代理使用 127.0.0.1；通过服务器 IP 直连时改成 0.0.0.0。
HSCODE_BIND_HOST=127.0.0.1
VECTOR_THREADS=4

# 模型下载端点；国内网络可改成 https://hf-mirror.com。
HF_ENDPOINT=https://huggingface.co
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=60
# 可选：容器内本地模型目录，跳过网络下载。
HS_MODEL_PATH=

# 构建软件源；网络较慢时可参考 README 切换为国内镜像。
PYPI_INDEX_URL=https://pypi.org/simple
DEBIAN_MIRROR=http://deb.debian.org/debian
DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
