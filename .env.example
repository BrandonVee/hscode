# 单个 PostgreSQL URL；密码中的 @、:、/、# 等字符需要 URL 编码。
# Docker 访问宿主机用 host.docker.internal；本机直接运行改为 127.0.0.1。
DATABASE_URL=postgresql://hscode:replace-with-your-database-password@host.docker.internal:5432/hscode

# bridge 网络：宿主机监听地址和映射端口，容器内部固定 8765。
HSCODE_PORT=8765
# 默认允许通过服务器 IP 访问；仅同机反向代理时可改为 127.0.0.1。
HSCODE_BIND_HOST=0.0.0.0
HSCODE_LOG_LEVEL=INFO
VECTOR_THREADS=4

# 模型下载端点；国内网络可改成 https://hf-mirror.com。
HF_ENDPOINT=https://huggingface.co
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=60
# 可选：容器内本地模型目录，跳过网络下载。
HS_MODEL_PATH=

# 构建软件源；网络较慢时可参考 README 切换为国内镜像。
PYPI_INDEX_URL=https://pypi.org/simple
DEBIAN_MIRROR=http://deb.debian.org/debian
DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
